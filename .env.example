# Neon Flux Template Configuration

# Site Information
NEXT_PUBLIC_SITE_NAME="Neon Flux"
NEXT_PUBLIC_SITE_URL="https://neon-flux.vercel.app"

# Theme Colors (Neon Colors)
NEXT_PUBLIC_PRIMARY_COLOR="#FF10F0"
NEXT_PUBLIC_SECONDARY_COLOR="#00FFF0"
NEXT_PUBLIC_ACCENT_COLOR="#FFFF00"

# Features Toggle
NEXT_PUBLIC_ENABLE_SOUND=true
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_PARTICLES=true
NEXT_PUBLIC_ENABLE_GLITCH=true
NEXT_PUBLIC_ENABLE_SCANLINES=true

# Performance Settings
NEXT_PUBLIC_PARTICLE_COUNT=500
NEXT_PUBLIC_3D_QUALITY="high" # Options: low, medium, high
NEXT_PUBLIC_ANIMATION_SPEED=1.0

# Analytics (Optional)
# NEXT_PUBLIC_GA_TRACKING_ID=""
# NEXT_PUBLIC_GTM_ID=""

# Contact Form (Optional)
# NEXT_PUBLIC_FORM_ENDPOINT=""
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
