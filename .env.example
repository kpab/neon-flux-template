# ===========================================
# Neon Flux Template - Environment Variables
# ===========================================
# This template works WITHOUT any environment variables.
# These are OPTIONAL settings for customization.
# Copy this file to .env.local and modify as needed.

# -----------------------------------------
# Site Information (Optional)
# -----------------------------------------
# Used for SEO meta tags and site branding
# NEXT_PUBLIC_SITE_NAME="Neon Flux"
# NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# -----------------------------------------
# Analytics (Optional)
# -----------------------------------------
# Get your ID from: https://analytics.google.com/
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
